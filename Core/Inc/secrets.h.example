/**
 * @file    secrets.h.example  —— 模板，不是能直接编译的文件
 * @brief   云端上报的私有参数（Wi-Fi / 设备身份 / 接入域名）
 *
 * 用法
 * --------------------------------------------------------------------------
 *   1) 复制成 `Core/Inc/secrets.h`（同目录）：
 *        cp Core/Inc/secrets.h.example Core/Inc/secrets.h
 *   2) 把下面 4 个字符串换成自己的值（值里的引号要保留）。
 *   3) 在 STM32CubeIDE 里 Project → C/C++ Build → Build 一次。
 *
 * 🔴 `secrets.h` **已在 .gitignore 里**，不会被提交 —— 别把它改成 .example
 *    以外的名字再提交，密钥进 git 历史就洗不掉了（只能重置设备密钥）。
 *
 * 🔴 这个文件只影响"云这一层"：不创建它、或者把 APP_CLOUD_ENABLE 设 0，
 *    固件照样能编、能烧、能跑模式 3（本地推理 + 串口日志）。
 */
#ifndef SECRETS_H
#define SECRETS_H

/* 1 = 打开云端上报
 *
 * 🔴 打开之前先把 `Core/Src/main.c` 里的 `APP_OUTPUT_MODE` 改成 **3**
 *    （相似度只有在线推理模式才产生）。顺序反了不会静默出错 ——
 *    编译器会直接报 `APP_CLOUD_ENABLE=1 requires APP_OUTPUT_MODE=3`，
 *    看到这条错，回去改模式即可。 */
#define APP_CLOUD_ENABLE    0

/* ---- Wi-Fi：必须是 2.4 GHz，ESP8266 不支持 5 GHz ---------------- */
#define CLOUD_WIFI_SSID     "your-ssid"
#define CLOUD_WIFI_PASS     "your-password"

/* ---- 设备身份（见 RUNBOOK R14.6 / R14.7）----------------------- */
/* 形如 `6ad76a1dcbb0cf6bb98f1aee_stm32-01` = 产品ID_NodeId */
#define CLOUD_DEVICE_ID     "PASTE_DEVICE_ID_HERE"
/* 注册设备时**你自己填**的 8~32 位密钥；已有设备改不了，只能重置 */
#define CLOUD_SECRET        "PASTE_DEVICE_SECRET_HERE"

/* ---- 鉴权 ts（10 位 YYYYMMDDHH）--------------------------------
 * `sig_type=0` 时平台**不校验内容**（2026-10-22 实测，见 R14.2 ①），
 * 所以写成常量即可，STM32 不需要 RTC/SNTP。
 * 若哪天平台改成严格校验，把这一行改成真实 UTC 时间就能用（其余代码不动）。 */
/* #define AUTH_TS          "2026102205" */

#endif /* SECRETS_H */
